[0.001, "o", "\r\u001b[K                               Available networks\u001b[1;90m                              \u001b[0m\r\n\u001b[32m[iwd]\u001b[0m# exi\r\u001b[K\u001b[90m--------------------------------------------------------------------------------\r\n\u001b[0m\u001b[32m[iwd]\u001b[0m# exi\r\u001b[K\u001b[1;90m      Network name                      Security            Signal\r\n\u001b[0m\u001b[32m[iwd]\u001b[0m# exi\r\u001b[K\u001b[90m--------------------------------------------------------------------------------\r\n\u001b[0m\u001b[32m[iwd]\u001b[0m# exi\r\u001b[K  \u001b[1;90m> \u001b[0m  Shiro72                           psk                 ****    \r\n\u001b[32m[iwd]\u001b[0m# exi\r\u001b[K      WARJO - System Only               psk                 ***\u001b[1;90m*\u001b[0m    \r\n\u001b[32m[iwd]\u001b[0m# exi\r\u001b[K      OPPA✅                            psk                 ****    \r\n\u001b[32m[iwd]\u001b[0m# exi\r\u001b[K      EJOI                              psk                 ****    \r\n\u001b[32m[iwd]\u001b[0m# exi\r\u001b[K      Zaskia Syahda                     psk                 ***\u001b[1;90m*\u001b[0m    \r\n\u001b[32m[iwd]\u001b[0m# exi\r\u001b[K      dhejun                            psk                 ****    \r\n\u001b[32m[iwd]\u001b[0m# exi\r\u001b[K      kepo deh hehe                     psk                 ****    \r\n\u001b[32m[iwd]\u001b[0m# exi\r\u001b[K      Infinix HOT 20S                   psk                 ***\u001b[1;90m*\u001b[0m    \r\n\u001b[32m[iwd]\u001b[0m# exi\r\u001b[K      SCOUTRESCUE                       psk                 **\u001b[1;90m**\u001b[0m    \r\n\u001b[32m[iwd]\u001b[0m# exi\r\u001b[K      WARJON - PAMULANG                 psk                 ****    \r\n\u001b[32m[iwd]\u001b[0m# exi\r\u001b[K      OPPO Reno14 5G 843A               psk                 ***\u001b[1;90m*\u001b[0m    \r\n\u001b[32m[iwd]\u001b[0m# exi\r\u001b[K      POCO M3 Pro 5G                    psk                 ***\u001b[1;9